<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavBar"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_alignParentBottom="true"
    android:background="@drawable/bg_bottom_nav"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Tab: Inicio -->
    <LinearLayout
        android:id="@+id/tabNavHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavHome"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Inicio"
            android:src="@drawable/ic_home" />

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Inicio"
            android:textColor="@color/cq_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab: Resultados -->
    <LinearLayout
        android:id="@+id/tabNavResults"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavResults"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Resultados"
            android:src="@drawable/ic_chart" />

        <TextView
            android:id="@+id/tvNavResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Resultados"
            android:textColor="@color/cq_text_faint"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Tab: Cerrar sesión -->
    <LinearLayout
        android:id="@+id/tabNavLogout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavLogout"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Cerrar sesión"
            android:src="@drawable/ic_logout" />

        <TextView
            android:id="@+id/tvNavLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Cerrar sesión"
            android:textColor="@color/cq_text_faint"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
