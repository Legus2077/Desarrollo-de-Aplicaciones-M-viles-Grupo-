<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cq_void">

    <ScrollView
        android:id="@+id/screenTestResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cq_void"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Top Nav -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    android:id="@+id/btnBackFromTestResult"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_card_surface"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="Volver al inicio"
                        android:src="@drawable/ic_arrow_back" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="Resultado del test"
                    android:textColor="@color/cq_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Score circle -->
            <FrameLayout
                android:id="@+id/resultScoreCircle"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_score_circle">

                <TextView
                    android:id="@+id/tvFinalScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="0%"
                    android:textColor="@color/cq_text"
                    android:textSize="38sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvFinalStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="Aprobado"
                android:textColor="@color/cq_success"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFinalLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="6dp"
                android:text="Test Básico"
                android:textColor="@color/cq_text_dim"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/tvFinalThreshold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="Puntaje mínimo para aprobar: 80%"
                android:textColor="@color/cq_text_faint"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFinalMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="28dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:textColor="@color/cq_text_dim"
                android:textSize="13.5sp" />

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingEnd="24dp">

                <Button
                    android:id="@+id/btnRetryTest"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_button_primary"
                    android:stateListAnimator="@null"
                    android:text="Volver a intentarlo"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnGoHomeFromResult"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_ghost"
                    android:stateListAnimator="@null"
                    android:text="Ir al inicio"
                    android:textAllCaps="false"
                    android:textColor="@color/cq_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnDownloadFromResult"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_ghost"
                    android:drawableStart="@drawable/ic_download"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:stateListAnimator="@null"
                    android:text="Descargar resultados"
                    android:textAllCaps="false"
                    android:textColor="@color/cq_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <include
        layout="@layout/include_welcome_toast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true" />

    <!-- HU11: animacion de carga al finalizar el test -->
    <FrameLayout
        android:id="@+id/loadingResult"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/cq_void"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <FrameLayout
                android:id="@+id/loadingLogo"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:background="@drawable/bg_logo_mark">

                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_shield_check" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="Calculando tu resultado…"
                android:textColor="@color/cq_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Estamos evaluando tus respuestas"
                android:textColor="@color/cq_text_faint"
                android:textSize="12sp" />

        </LinearLayout>
    </FrameLayout>

</RelativeLayout>
