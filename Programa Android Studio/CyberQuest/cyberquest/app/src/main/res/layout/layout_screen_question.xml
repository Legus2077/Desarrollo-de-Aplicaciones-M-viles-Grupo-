<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screenQuestion"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cq_void"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- Top Nav -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:id="@+id/btnBackFromQuestion"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_card_surface"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:contentDescription="Salir"
                    android:src="@drawable/ic_arrow_back" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvQuestionHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Test Básico"
                android:textColor="@color/cq_text"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Progress bar and counter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <ProgressBar
                android:id="@+id/pbQuestionProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:indeterminate="false"
                android:max="100"
                android:progress="50"
                android:progressDrawable="@drawable/progress_custom_horizontal" />

            <TextView
                android:id="@+id/tvQuestionProgressCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pregunta 1 de 2"
                android:textColor="@color/cq_text_faint"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Question Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:id="@+id/tvQuestionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="22dp"
                android:lineSpacingExtra="4dp"
                android:text="¿Cuál de estas contraseñas es la más segura?"
                android:textColor="@color/cq_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Option A -->
            <LinearLayout
                android:id="@+id/optContainerA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_default"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/optBadgeA"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_option_letter"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optTextA"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="123456789"
                    android:textColor="@color/cq_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Option B -->
            <LinearLayout
                android:id="@+id/optContainerB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_default"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/optBadgeB"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_option_letter"
                    android:gravity="center"
                    android:text="B"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optTextB"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Nombre2024"
                    android:textColor="@color/cq_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Option C -->
            <LinearLayout
                android:id="@+id/optContainerC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_option_default"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/optBadgeC"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_option_letter"
                    android:gravity="center"
                    android:text="C"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optTextC"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Sofá7#Lampara!Río"
                    android:textColor="@color/cq_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Option D -->
            <LinearLayout
                android:id="@+id/optContainerD"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_option_default"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/optBadgeD"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_option_letter"
                    android:gravity="center"
                    android:text="D"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/optTextD"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="password"
                    android:textColor="@color/cq_text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Next Button -->
            <Button
                android:id="@+id/btnNextQuestion"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_button_primary"
                android:stateListAnimator="@null"
                android:text="Siguiente"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
