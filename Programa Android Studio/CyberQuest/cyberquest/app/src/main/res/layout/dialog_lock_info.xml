<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_sheet"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_modal_handle" />

    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="Test Intermedio bloqueado"
        android:textColor="@color/cq_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLockMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:lineSpacingExtra="4dp"
        android:text="Necesitas obtener al menos 80% en el Test Básico para desbloquear el Test Intermedio."
        android:textColor="@color/cq_text_dim"
        android:textSize="13.5sp" />

    <Button
        android:id="@+id/btnLockDismiss"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_button_ghost"
        android:stateListAnimator="@null"
        android:text="Entendido"
        android:textAllCaps="false"
        android:textColor="@color/cq_text"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
